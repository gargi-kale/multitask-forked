# Include important metadata files
include LICENSE
include README.md
include pyproject.toml
include requirements.txt

# Include all package data
recursive-include multitask *.py
recursive-include multitask py.typed

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib

# Exclude development and test files
exclude Makefile
exclude main.py
exclude main_embedding.py
exclude main.ipynb
recursive-exclude tests *
recursive-exclude docs *
recursive-exclude examples *
recursive-exclude configs *
recursive-exclude data *
recursive-exclude input *
recursive-exclude output *
recursive-exclude results *
recursive-exclude train_test *
recursive-exclude models *
recursive-exclude utils *
prune .git
prune .github
