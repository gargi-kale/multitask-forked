# Include important metadata files
include LICENSE
include README.md
include pyproject.toml

# Include all package data
recursive-include multitask *.py
recursive-include multitask py.typed

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib

# Exclude development, test, and legacy files
recursive-exclude tests *
recursive-exclude docs *
recursive-exclude examples *
recursive-exclude legacy *
recursive-exclude multitask/local_test_runs *
recursive-exclude multitask/cluster_runs *
exclude environment.yml
exclude requirements.txt
prune .git
prune .github
prune .embedding_cache
